# Copie ce fichier en `.env` (gitignored) et remplace les valeurs.
# Tu peux générer un token avec :
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"

# Token requis pour appeler POST /rebuild.
# Si absent, l'endpoint /rebuild répond 503 (fail-secure).
ADMIN_TOKEN=

# Optionnel — surcharge la cible Ollama. Par défaut http://localhost:11434.
# Utile en Docker : OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_HOST=
# OLLAMA_MODEL=mistral-small:latest
# LLM_TEMPERATURE=0
