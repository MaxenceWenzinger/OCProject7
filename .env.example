# Copie ce fichier en `.env` (gitignored) et remplace les valeurs.
# Tu peux générer un token avec :
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"

# Token requis pour appeler POST /rebuild.
# Si absent, l'endpoint /rebuild répond 503 (fail-secure).
ADMIN_TOKEN=

# Provider LLM : `mistral` (défaut, API cloud) ou `ollama` (local offline).
# LLM_PROVIDER=mistral

# Clé API Mistral. Obligatoire si LLM_PROVIDER=mistral.
# Tier gratuit suffisant pour le POC.
# Création : https://console.mistral.ai/
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest

# Configuration Ollama (utilisé si LLM_PROVIDER=ollama).
# OLLAMA_HOST=http://localhost:11434
# Utile en Docker : OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_MODEL=mistral-small:latest

# Température partagée par les deux providers.
# LLM_TEMPERATURE=0
